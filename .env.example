APP_NAME=samatalk-api
APP_ENV=local

HTTP_ADDRESS=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=1m
HTTP_SHUTDOWN_TIMEOUT=10s
HEALTH_CHECK_TIMEOUT=2s

DATABASE_URL=postgres://samatalk:samatalk_dev_password@localhost:5432/samatalk?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_CONNECT_TIMEOUT=5s